[
  {
    "namespace": "sieve.socket",
    "description": "Sieve socket connection helpers",
    "functions": [
      {
        "name": "create",
        "type": "function",
        "description": "Creates a socket handle for a remote server without connecting yet.",
        "async": true,
        "parameters": [
          {
            "name": "host",
            "type": "string",
            "description": "The remote host name."
          },
          {
            "name": "port",
            "type": "string",
            "description": "The remote port."
          },
          {
            "name": "level",
            "type": "integer",
            "description": "The log level to use."
          }
        ]
      },
      {
        "name": "connect",
        "type": "function",
        "description": "Connects the socket to the remote server.",
        "async": true,
        "parameters": [
          {
            "name": "id",
            "type": "string",
            "description": "The unique socket handle."
          }
        ]
      },
      {
        "name": "startTLS",
        "type": "function",
        "description": "Upgrades the connected socket to TLS using STARTTLS.",
        "async": true,
        "parameters": [
          {
            "name": "id",
            "type": "string",
            "description": "The unique socket handle."
          }
        ]
      },
      {
        "name": "send",
        "type": "function",
        "description": "Sends the given byte array over the socket.",
        "async": true,
        "parameters": [
          {
            "name": "id",
            "type": "string",
            "description": "The unique socket handle."
          },
          {
            "name": "bytes",
            "type": "array",
            "description": "The data to send as a byte array.",
            "items": {
              "type": "integer"
            }
          }
        ]
      },
      {
        "name": "isAlive",
        "type": "function",
        "description": "Checks whether the specified socket is still alive.",
        "async": true,
        "parameters": [
          {
            "name": "id",
            "type": "string",
            "description": "The unique socket handle."
          }
        ]
      },
      {
        "name": "disconnect",
        "type": "function",
        "description": "Disconnects the socket from the remote server.",
        "async": true,
        "parameters": [
          {
            "name": "id",
            "type": "string",
            "description": "The unique socket handle."
          }
        ]
      },
      {
        "name": "destroy",
        "type": "function",
        "description": "Disconnects and removes the specified socket handle.",
        "async": true,
        "parameters": [
          {
            "name": "id",
            "type": "string",
            "description": "The unique socket handle."
          }
        ]
      },
      {
        "name": "addCertErrorOverride",
        "type": "function",
        "description": "Adds a certificate exception for the specified host, port, and certificate.",
        "async": true,
        "parameters": [
          {
            "name": "host",
            "type": "string",
            "description": "The hostname for which to add the override."
          },
          {
            "name": "port",
            "type": "string",
            "description": "The port for which to add the override."
          },
          {
            "name": "rawDER",
            "type": "array",
            "description": "The server certificate as raw DER bytes.",
            "items": {
              "type": "integer"
            }
          },
          {
            "name": "flags",
            "type": "integer",
            "description": "The Thunderbird certificate override flags."
          }
        ]
      }
    ],
    "events": [
      {
        "name": "onData",
        "type": "function",
        "description": "Called when data is received on the socket.",
        "parameters": [
          {
            "name": "bytes",
            "type": "array",
            "description": "The received data as a byte array.",
            "items": {
              "type": "integer"
            }
          }
        ],
        "returns": {},
        "extraParameters": [
          {
            "name": "socket",
            "type": "string",
            "description": "The unique socket handle."
          }
        ]
      },
      {
        "name": "onError",
        "type": "function",
        "description": "Called when the socket encounters an error.",
        "parameters": [
          {
            "name": "error",
            "type": "object",
            "description": "An object containing error details."
          }
        ],
        "returns": {},
        "extraParameters": [
          {
            "name": "id",
            "type": "string",
            "description": "The unique socket handle."
          }
        ]
      },
      {
        "name": "onClose",
        "type": "function",
        "description": "Called after the socket has been closed.",
        "parameters": [],
        "returns": {},
        "extraParameters": [
          {
            "name": "id",
            "type": "string",
            "description": "The unique socket handle."
          }
        ]
      }
    ]
  }
]