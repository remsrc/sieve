[
  {
    "namespace": "sieve.menu",
    "description": "Sieve menu integration helpers",
    "functions": [
      {
        "name": "has",
        "type": "function",
        "description": "Checks whether the specified menu item exists in the given window.",
        "async": true,
        "parameters": [
          {
            "name": "windowId",
            "type": "string",
            "description": "The unique window id."
          },
          {
            "name": "widgetId",
            "type": "string",
            "description": "The widget id to look up."
          }
        ]
      },
      {
        "name": "add",
        "type": "function",
        "description": "Adds a menu widget to the given window. If an item with the same id already exists, it is replaced.",
        "async": true,
        "parameters": [
          {
            "name": "windowId",
            "type": "string",
            "description": "The unique window id."
          },
          {
            "name": "widget",
            "type": "object",
            "description": "The widget definition."
          }
        ]
      },
      {
        "name": "remove",
        "type": "function",
        "description": "Removes the specified menu widget from the given window.",
        "async": true,
        "parameters": [
          {
            "name": "windowId",
            "type": "string",
            "description": "The unique window id."
          },
          {
            "name": "widgetId",
            "type": "string",
            "description": "The widget id to remove."
          }
        ]
      }
    ],
    "events": [
      {
        "name": "onCommand",
        "type": "function",
        "description": "Fired when a registered menu item is activated.",
        "parameters": [
          {
            "name": "windowId",
            "type": "string",
            "description": "The unique window id."
          },
          {
            "name": "id",
            "type": "string",
            "description": "The activated widget id."
          }
        ]
      }
    ]
  }
]