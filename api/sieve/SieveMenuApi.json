[
  {
    "namespace": "sieve.menu",
    "description": "Sieve menu integration helpers",
    "types": [
      {
        "id": "WidgetType",
        "type": "string",
        "enum": [
          "menu-label",
          "menu-separator",
          "appmenu-label",
          "appmenu-separator"
        ],
        "description": "The supported widget types."
      },
      {
        "id": "WidgetPosition",
        "type": "string",
        "enum": [
          "before",
          "after",
          "child"
        ],
        "description": "Defines where the widget is inserted relative to the reference element."
      },
      {
        "id": "MenuWidget",
        "type": "object",
        "description": "A widget definition for insertion into Thunderbird menus.",
        "properties": {
          "id": {
            "type": "string",
            "description": "The unique widget id."
          },
          "type": {
            "$ref": "WidgetType",
            "description": "The widget type."
          },
          "reference": {
            "type": "string",
            "description": "The id of the reference DOM element."
          },
          "position": {
            "$ref": "WidgetPosition",
            "description": "Where to insert the widget relative to the reference element."
          },
          "label": {
            "type": "string",
            "optional": true,
            "description": "The label shown for label widgets."
          },
          "accesskey": {
            "type": "string",
            "optional": true,
            "description": "Optional access key for label widgets."
          }
        }
      }
    ],
    "functions": [
      {
        "name": "has",
        "type": "function",
        "description": "Checks whether the specified menu item exists in the given window.",
        "async": true,
        "parameters": [
          {
            "name": "windowId",
            "type": "string",
            "description": "The unique window id."
          },
          {
            "name": "widgetId",
            "type": "string",
            "description": "The widget id to look up."
          }
        ]
      },
      {
        "name": "add",
        "type": "function",
        "description": "Adds a menu widget to the given window. If an item with the same id already exists, it is replaced.",
        "async": true,
        "parameters": [
          {
            "name": "windowId",
            "type": "string",
            "description": "The unique window id."
          },
          {
            "name": "widget",
            "$ref": "MenuWidget"
          }
        ]
      },
      {
        "name": "remove",
        "type": "function",
        "description": "Removes the specified menu widget from the given window.",
        "async": true,
        "parameters": [
          {
            "name": "windowId",
            "type": "string",
            "description": "The unique window id."
          },
          {
            "name": "widgetId",
            "type": "string",
            "description": "The widget id to remove."
          }
        ]
      }
    ],
    "events": [
      {
        "name": "onCommand",
        "type": "function",
        "description": "Fired when a registered menu item is activated.",
        "parameters": [
          {
            "name": "windowId",
            "type": "string",
            "description": "The unique window id."
          },
          {
            "name": "id",
            "type": "string",
            "description": "The activated widget id."
          }
        ]
      }
    ]
  }
]