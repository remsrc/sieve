{
  "name": "Sieve Reloaded",
  "description": "__MSG_extensionDescription__",
  "version": "1.0.0",
  "icons": {
    "32": "libs/icons/sieve32.png",
    "64": "libs/icons/sieve64.png",
    "128": "libs/icons/sieve128.png"
  },
  "background": {
    "page": "background.html"
  },
  "manifest_version": 2,
  "default_locale": "en_US",
  "browser_specific_settings": {
    "gecko": {
      "id": "sieve.remsrc@mozdev.org",
      "strict_min_version": "128.0"
     }
  },
  "permissions": [
    "accountsRead",
    "tabs",
    "storage"
  ],
  "experiment_apis": {
    "SieveAccountsApi": {
      "schema": "api/sieve/SieveAccountsApi.json",
      "parent": {
        "scopes": [
          "addon_parent"
        ],
        "script": "api/sieve/SieveAccountsApi.js",
        "paths": [
          [
            "sieve",
            "accounts"
          ]
        ]
      }
    },
    "SieveSocketApi": {
      "schema": "api/sieve/SieveSocketApi.json",
      "parent": {
        "scopes": [
          "addon_parent"
        ],
        "script": "api/sieve/SieveSocketApi.js",
        "paths": [
          [
            "sieve",
            "socket"
          ]
        ]
      }
    },
    "SieveMenuApi": {
      "schema": "api/sieve/SieveMenuApi.json",
      "parent": {
        "scopes": [
          "addon_parent"
        ],
        "script": "api/sieve/SieveMenuApi.js",
        "paths": [
          [
            "sieve",
            "menu"
          ]
        ]
      }
    }
  }
}